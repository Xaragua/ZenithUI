<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- The demo switches between en-US, es-ES and es-DO at startup (see Program.cs). Without the
         full ICU data the runtime ships only the browser language's shard and throws on a change. -->
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The client project references ZenithUI as well as the server project. This is what proves
      render-mode agnosticism: components in this assembly run in the browser's WebAssembly
      runtime, with a different DI container and a different IJSRuntime implementation from the
      server-rendered pages.
    -->
    <ProjectReference Include="..\..\src\ZenithUI\ZenithUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
  </ItemGroup>

</Project>
