@inherits LayoutComponentBase

@*
    The demo's shell, and the point of M5: this file used to hand-roll a header, two navs and a
    footer because the library had none. It is now composition, and the thing worth noticing is
    what is NOT here.

    THERE IS NO @rendermode ON THE SHELL. The layout is static SSR - it has to be, because @Body is
    a RenderFragment and a render fragment cannot cross a render-mode boundary - and the navigation
    works anyway, drawer included. The menu button is a <button popovertarget> pointed at the side
    nav's id; the browser does the rest. Only the theme toggle is an interactive island.

    Narrow the window below 1024px and the rail becomes a drawer. Open it with keyboard and
    JavaScript both disabled and it still opens: that is the platform's popover, not ours.

    ZenThemeProvider is still deliberately absent. It would have to wrap @Body, and a static
    provider never gets a JavaScript runtime to initialize against. See Pages/Theming.razor for the
    provider in the role it exists for.
*@

<ZenAppShell MaxWidth="ZenContentWidth.Wide">

    <Header>
        <ZenAppBar>
            <Brand>
                <a href="/" class="zen-focus flex items-center gap-2 rounded-zen-sm">
                    <span class="grid size-7 place-items-center rounded-zen-md bg-primary text-sm text-primary-content">Z</span>
                    <span>ZenithUI</span>
                </a>
            </Brand>

            <ChildContent>
                @* The bar's nav is hidden below `lg`, where the same links are in the drawer.
                   Hidden rather than duplicated-and-hidden: `hidden` is display:none, so these
                   links leave the accessibility tree entirely and are not announced twice. *@
                <ZenNavMenu Orientation="ZenNavOrientation.Horizontal"
                            Label="Sections"
                            Class="ms-2 hidden lg:flex">
                    @foreach (var link in NavLinks)
                    {
                        <ZenNavLink Href="@link.Href" Text="@link.Label" />
                    }
                </ZenNavMenu>
            </ChildContent>

            <Actions>
                <ZenThemeToggle Mode="ZenThemeToggleMode.Segmented"
                                Size="ZenSize.Small"
                                @rendermode="InteractiveServer" />
            </Actions>
        </ZenAppBar>
    </Header>

    <SideNav>
        @* No render mode. The drawer opens, closes, dismisses on Escape and returns focus to the
           button without one. Giving it InteractiveServer would add the focus trap and the scroll
           lock - see ZenSideNav's bindDrawer call - but the trade is a circuit per page, and the
           shell is meant to show the floor rather than the ceiling. *@
        <ZenSideNav Label="Sections">
            <Header>
                <span class="font-semibold tracking-tight">ZenithUI</span>
            </Header>

            <ChildContent>
                <ZenNavMenu Landmark="false">
                    @foreach (var link in NavLinks)
                    {
                        <ZenNavLink Href="@link.Href" Text="@link.Label" Icon="@link.Icon" />
                    }
                </ZenNavMenu>
            </ChildContent>

            <Footer>
                <p class="px-3 text-xs text-content-subtle">Milestone M5</p>
            </Footer>
        </ZenSideNav>
    </SideNav>

    <Footer>
        <ZenFooter MaxWidth="ZenContentWidth.Wide">
            <Start>
                <p>ZenithUI &middot; milestone M5 &mdash; chrome, layout and navigation.</p>
                <p class="mt-1 text-content-subtle">
                    Every colour on this page resolves through a <code>--zen-*</code> custom
                    property. Switching the theme repaints without re-rendering a single component.
                </p>
            </Start>

            <End>
                <a href="/shell" class="zen-focus rounded-zen-sm hover:text-content">Shell</a>
                <a href="/tokens" class="zen-focus rounded-zen-sm hover:text-content">Tokens</a>
            </End>
        </ZenFooter>
    </Footer>

    <ChildContent>
        @Body

        @* One host per document renders every dialog IZenModalService has open. It lives in the
           layout rather than on a page so a dialog survives navigation between pages, and so pages
           do not each have to remember to include one. *@
        <ZenModalHost @rendermode="InteractiveServer" />

        @* Same rule as the modal host: exactly one per document, or every toast renders - and
           announces - twice. *@
        <ZenToastHost Position="ZenToastPosition.BottomEnd" @rendermode="InteractiveServer" />
    </ChildContent>

</ZenAppShell>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&#128937;</span>
</div>

@code {
    private static readonly (string Href, string Label, string Icon)[] NavLinks =
    [
        ("", "Overview", ZenIcons.Inbox),
        ("tokens", "Tokens", ZenIcons.Sun),
        ("primitives", "Primitives", ZenIcons.Check),
        ("forms", "Forms", ZenIcons.Search),
        ("theming", "Theming", ZenIcons.Moon),
        ("overlays", "Overlays", ZenIcons.Info),
        ("data", "Data", ZenIcons.Calendar),
        ("shell", "Shell", ZenIcons.Menu),
        ("render-modes", "Render modes", ZenIcons.Monitor),
    ];
}
