@namespace ZenithUI
@inherits ComponentBase
@implements IDisposable

@*
    One step of a ZenStepper. Renders nothing itself - it is a declaration that the stepper reads,
    as ZenColumn is for ZenTable, and for the same reason: the stepper's header lists every step,
    and its body shows only one, so neither can be rendered where the step is written.
*@

@code {
    /// <summary>The stepper this step belongs to.</summary>
    [CascadingParameter]
    public ZenStepper Stepper { get; set; } = default!;

    /// <summary>The step's name, in the header and above its content.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>A short line under the title in the header.</summary>
    [Parameter]
    public string? Description { get; set; }

    /// <summary>The step's content, shown while it is the active step.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Mark the step as optional in the header.</summary>
    /// <remarks>A label only. Whether the step can be passed with nothing filled in is decided by
    /// its validation, which the stepper cannot second-guess.</remarks>
    [Parameter]
    public bool Optional { get; set; }

    /// <summary>Skip this step: it cannot be reached, and Next and Back pass over it.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// A problem with the step, shown in the header and above its content. Set it after a failed
    /// submit to send the user back to the step at fault.
    /// </summary>
    [Parameter]
    public string? Error { get; set; }

    /// <summary>
    /// The form on this step. When set, the stepper will not move forward until
    /// <see cref="EditContext.Validate"/> passes.
    /// </summary>
    [Parameter]
    public EditContext? EditContext { get; set; }

    /// <summary>
    /// Called as the user tries to leave the step, in either direction. Set
    /// <see cref="ZenStepLeavingArgs.Cancel"/> to stay.
    /// </summary>
    /// <remarks>
    /// Runs after <see cref="EditContext"/> validation has passed, so it only sees a step the
    /// form considers valid - the place for a server-side check, such as whether a username is
    /// taken.
    /// </remarks>
    [Parameter]
    public Func<ZenStepLeavingArgs, Task>? OnLeaving { get; set; }

    /// <inheritdoc />
    protected override void OnParametersSet() => Stepper.Register(this);

    /// <inheritdoc />
    public void Dispose() => Stepper?.Unregister(this);
}
