@namespace ZenithUI

@typeparam TValue
@inherits ZenComponentBase

@*
    One option of a ZenSegmentedButton: a <label> around a visually hidden radio.

    The label is the target, so the whole segment is clickable, and the radio inside is what takes
    focus and is announced. An icon-only segment has no text for the radio to be named by, so its
    Title becomes the radio's aria-label (and the segment's tooltip).
*@

<label class="@RootClass(SegmentClass)" style="@Style" title="@Title">
    <input id="@Id"
           type="radio"
           class="zen-sr-only"
           name="@Group.GroupName"
           value="@Value?.ToString()"
           checked="@IsSelected"
           disabled="@IsDisabled"
           aria-label="@(HasText ? null : Title)"
           @attributes="AttributesWithoutClass"
           @onchange="HandleChange" />

    @if (Icon is not null)
    {
        <ZenIcon Path="@Icon" Size="ZenSize.Small" class="shrink-0" aria-hidden="true" />
    }

    @if (ChildContent is not null)
    {
        <span class="truncate">@ChildContent</span>
    }
    else if (Label is not null)
    {
        <span class="truncate">@Label</span>
    }
</label>

@code {
    /// <summary>The control this segment belongs to.</summary>
    [CascadingParameter]
    private ZenSegmentedButton<TValue> Group { get; set; } = default!;

    /// <summary>The value this segment selects.</summary>
    [Parameter, EditorRequired]
    public TValue? Value { get; set; }

    /// <summary>The segment's text.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>Content in place of <see cref="Label"/>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>A leading icon, or the whole segment when there is no text.</summary>
    [Parameter]
    public string? Icon { get; set; }

    /// <summary>A tooltip. Required for an icon-only segment, whose accessible name it becomes.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Disables this segment alone.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    private bool HasText => ChildContent is not null || Label is not null;

    private bool IsSelected => Group.IsSelected(Value);

    // Read-only disables the unselected segments rather than all of them, so the chosen one stays
    // in the tab order and is still read out.
    private bool IsDisabled => Disabled || Group.GroupDisabled || (Group.GroupReadOnly && !IsSelected);

    private void HandleChange(ChangeEventArgs args) => Group.Select(Value);

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        if (Group is null)
        {
            throw new InvalidOperationException(
                $"{nameof(ZenSegment<TValue>)} must be placed inside a {nameof(ZenSegmentedButton<TValue>)}.");
        }
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (!HasText && string.IsNullOrWhiteSpace(Title))
        {
            throw new InvalidOperationException(
                $"An icon-only {nameof(ZenSegment<TValue>)} needs a {nameof(Title)}: it is the segment's only accessible name.");
        }
    }

    private string SegmentClass => CssBuilder
        .Default("zen-focus-visible-within relative inline-flex min-w-0 cursor-pointer select-none items-center justify-center font-medium text-content-muted transition-colors")
        .AddClass("hover:text-content has-disabled:cursor-not-allowed has-disabled:opacity-50 has-disabled:hover:text-content-muted")
        .AddClass(Group.CheckedClass)
        .AddClass("flex-1", Group.GroupFullWidth)
        .AddClass(Group.GroupSize switch
        {
            ZenSize.Small => "h-7 gap-1.5 rounded-[calc(var(--zen-radius-sm)-2px)] px-2.5 text-xs",
            ZenSize.Large => "h-10 gap-2 rounded-[calc(var(--zen-radius-lg)-2px)] px-4 text-base",
            _ => "h-8 gap-1.5 rounded-[calc(var(--zen-radius-md)-2px)] px-3 text-sm",
        })
        .AddClass(HasText ? null : "aspect-square px-0")
        .Build()!;
}
