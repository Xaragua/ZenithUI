@namespace ZenithUI

@inherits ZenInputBase<bool>

@*
    A checkbox.

    The real <input type="checkbox"> is kept and restyled rather than replaced by a div with
    role="checkbox". The native element brings keyboard handling, form participation, the
    indeterminate state and correct screen-reader announcement for free; every re-implementation
    has to rebuild those and usually misses at least one.

    Focus keeps the RING rather than the border treatment used by text fields. A checked box is
    filled with the primary colour, so a primary border on it would be invisible - the one case
    where recolouring the border genuinely cannot work.
*@

<div class="@RootClass(WrapperClass)" style="@Style">
    <div class="flex h-5 shrink-0 items-center">
        @*
            The tick and the bar are siblings of the input, overlaid on it, rather than
            pseudo-elements - see components/base.css for why an <input> cannot carry them.
            They stay in DOM order after the input so the `~` sibling selectors reach them.
        *@
        <span class="relative inline-flex shrink-0">
            <input id="@Id"
                   type="checkbox"
                   class="@BoxClass"
                   checked="@CurrentValue"
                   disabled="@Disabled"
                   aria-describedby="@DescribedBy"
                   aria-invalid="@(IsInvalid ? "true" : null)"
                   aria-required="@(Required ? "true" : null)"
                   @attributes="AttributesWithoutClass"
                   @onchange="HandleToggle" />

            <svg class="@($"zen-mark zen-mark-check {MarkSizeClass}")"
                 viewBox="0 0 16 16"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2.5"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <path d="m3.5 8.5 3 3 6-6.5" />
            </svg>

            <span class="@($"zen-mark zen-mark-dash {DashSizeClass}")" aria-hidden="true"></span>
        </span>
    </div>

    @if (Label is not null || ChildContent is not null || HelpText is not null)
    {
        <div class="min-w-0">
            <label for="@Id" class="@LabelClass">
                @if (ChildContent is not null)
                {
                    @ChildContent
                }
                else
                {
                    @Label
                }

                @if (Required)
                {
                    <span class="text-danger-strong" aria-hidden="true">*</span>
                }
            </label>

            @if (HelpText is not null)
            {
                <p id="@HelpId" class="mt-0.5 text-xs text-content-muted">@HelpText</p>
            }
        </div>
    }
</div>

@if (IsInvalid)
{
    <p id="@ErrorId" class="mt-1 flex items-start gap-1.5 text-xs" role="alert">
        <ZenIcon Path="@ZenIcons.Danger" Size="ZenSize.Small" class="mt-px size-3.5 text-danger-strong" />
        <span class="text-danger-strong">@ValidationMessages.First()</span>
    </p>
}

@code {
    /// <summary>Label content, when a plain string is not enough - a link in the consent text, say.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Renders the box in its indeterminate state: neither checked nor unchecked.
    /// </summary>
    /// <remarks>
    /// Purely visual, and that is not a limitation of this component but of HTML - the DOM has no
    /// indeterminate attribute, only a property, so it cannot be expressed in server-rendered
    /// markup. A "select all" box above a partial selection is the case this exists for; the bound
    /// value stays false.
    /// </remarks>
    [Parameter]
    public bool Indeterminate { get; set; }

    private string HelpId => $"{Id}-help";

    private string ErrorId => $"{Id}-error";

    private string? DescribedBy =>
        IsInvalid ? ErrorId : (HelpText is not null ? HelpId : null);

    private void HandleToggle(ChangeEventArgs args) =>
        CurrentValue = args.Value is bool b && b;

    private bool _appliedIndeterminate;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        // `indeterminate` is a DOM property with no attribute equivalent, so it cannot be set from
        // server-rendered markup at all. Skipped without an interactive renderer - which is
        // correct: a static render has no way to express it.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        // Nothing to do until someone actually asks for the state, and nothing to undo until it
        // has been applied at least once.
        if (!Indeterminate && !_appliedIndeterminate)
        {
            return;
        }

        await InvokeDomAsync("setIndeterminate", Id, Indeterminate);
        _appliedIndeterminate = Indeterminate;
    }

    private string WrapperClass => CssBuilder
        .Default("flex items-start gap-2.5")
        .AddClass(FieldClass)
        .Build()!;

    private string BoxClass => CssBuilder
        // zen-check draws the whole control from --zen-* tokens (see components/base.css); the UA
        // appearance is switched off. zen-focus, not zen-focus-border: a checked box is filled
        // with the primary colour, so a primary border on it would be invisible.
        .Default("zen-check zen-focus")
        .AddClass(BoxSizeClass)
        .Build()!;

    private string BoxSizeClass => Size switch
    {
        ZenSize.Small => "size-4",
        ZenSize.Large => "size-6",
        _ => "size-5",
    };

    private string MarkSizeClass => Size switch
    {
        ZenSize.Small => "size-2.5",
        ZenSize.Large => "size-4",
        _ => "size-3",
    };

    private string DashSizeClass => Size switch
    {
        ZenSize.Small => "h-0.5 w-2 rounded-full bg-current",
        ZenSize.Large => "h-0.5 w-3 rounded-full bg-current",
        _ => "h-0.5 w-2.5 rounded-full bg-current",
    };

    private string LabelClass => CssBuilder
        .Default("inline-flex cursor-pointer items-center gap-1 text-content")
        .AddClass(Size switch
        {
            ZenSize.Small => "text-xs",
            ZenSize.Large => "text-base",
            _ => "text-sm",
        })
        .AddClass("cursor-not-allowed opacity-60", Disabled)
        .Build()!;
}
