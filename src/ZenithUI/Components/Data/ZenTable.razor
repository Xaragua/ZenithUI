@namespace ZenithUI
@typeparam TItem where TItem : notnull
@inherits ZenJsComponentBase

@*
    A data table: sortable, pageable, selectable, optionally hierarchical, and collapsing to a
    stacked card list on a narrow screen.

    Columns are child components. The table's markup therefore depends on what its own children
    report, which a single render pass cannot normally deliver - a parent builds its whole render
    tree before any child exists. ZenDefer solves it by ordering rather than by rendering twice;
    the reasoning is in Core/ZenDefer.cs, and it is what lets a server-rendered table arrive with
    its body intact.

    WHAT ROLE THE TABLE CLAIMS

    A flat table stays a plain <table>. It is not given role="grid", even when rows are
    selectable, because a grid owes the user arrow-key navigation between cells and this component
    does not provide it - the same reason ZenList refuses to call a non-interactive list a
    listbox. Selection is expressed with real checkboxes instead, which are announced correctly,
    operable from the keyboard, and submit with a form. Nothing has to be promised to get them.

    A hierarchical table has no such option. HTML has no way to say "this row is a child of that
    one", so the nesting has to come from ARIA: role="treegrid", with aria-level and aria-expanded
    on the rows. Making that claim brings the keyboard contract with it, so the hierarchical table
    takes a roving tabindex over its rows and implements the arrow keys. ZenTree gets level and
    position free from its nested <ul>s and therefore states none of them; a table has no
    structure to lean on and has to state all of them. The two components differ because their
    markup differs, not because they disagree.

    WHAT THE TABLE KNOWS

    Given Items, sorting, paging, grouping and select-all operate on exactly those items. Given an
    ItemsProvider instead, the table asks for one window of rows at a time - a page, or whatever a
    virtualized body has scrolled into view - and passes the sort along as the column's SortName.
    The server does the work it is the only one able to do. The two are exclusive: a table cannot
    sort rows it was never given, and it does not pretend to.

    VIRTUALIZATION

    Virtualize renders only the rows in view, through the framework's own <Virtualize>, with <tr>
    spacers so the markup stays a valid table. It replaces paging rather than combining with it -
    both are answers to "too many rows", and a paged table has at most one page to render anyway.
    Every row is flattened into a single list first (group headers, tree rows, the lot), which is
    what lets a virtualized body group and expand without a second code path. aria-rowcount and
    aria-rowindex state the full size, because a screen reader otherwise counts only the handful
    of rows that exist in the DOM and announces "row 3 of 12" in a table of ten thousand.

    GROUPING

    GroupBy inserts a header row before each group's rows. The header is a <th scope="rowgroup">
    spanning the table, so a screen reader associates the rows below it with the group name the
    way it associates cells with column headers. Groups collapse with a disclosure button, and
    select as a whole with a tri-state checkbox. Grouping and the treegrid are exclusive: both
    are ways of nesting rows, and a row cannot sit at two depths at once.
*@

@{
    // Bumped before the cascade renders, so the first column to register knows the list it is
    // joining belongs to a previous pass and clears it.
    _generation++;
}

<CascadingValue Value="this" IsFixed="true">
    @Columns
</CascadingValue>

<ZenDefer>
    @{
        BuildRows();
    }

    <div id="@ScrollContainerId" class="@RootClass(WrapperClass)" style="@WrapperStyle" @attributes="AttributesWithoutClass">
        <table id="@Id"
               class="@TableClass"
               role="@TableRole"
               aria-label="@Label"
               aria-labelledby="@LabelledBy"
               aria-busy="@(IsLoading ? "true" : null)"
               aria-rowcount="@AriaRowCount"
               @onfocusin="@(() => _hasFocus = true)"
               @onfocusout="@(() => _hasFocus = false)"
               @onkeydown="HandleKeyDownAsync">
            @if (Caption is not null)
            {
                @* A <caption> rather than a heading above the table: it is the table's accessible
                   name for free, and a screen reader announces it on entry. *@
                <caption class="px-3 py-2 text-start text-sm text-content-muted">@Caption</caption>
            }

            <thead class="@HeadClass">
                <tr aria-rowindex="@(Virtualize ? 1 : null)">
                    @if (HasDetails)
                    {
                        @* The toggle column needs a header for the column count to line up, and a
                           name for the row-header association a screen reader builds from it. The
                           name is visually hidden: a visible "Details" above a column of chevrons
                           is a word doing no work. *@
                        <th scope="col" class="@($"{HeaderCellClass} w-px")">
                            <span class="zen-sr-only">Details</span>
                        </th>
                    }

                    @if (Selectable)
                    {
                        <th scope="col" class="@($"{HeaderCellClass} w-px")">
                            <ZenCheckbox Value="@AllOnPageSelected"
                                         ValueChanged="ToggleAllAsync"
                                         Indeterminate="@(SomeOnPageSelected && !AllOnPageSelected)"
                                         aria-label="Select all rows on this page" />
                        </th>
                    }

                    @foreach (var column in _columns)
                    {
                        @* aria-sort is stated on every sortable column, "none" included. A column
                           that says nothing gives no hint it can be sorted, and the user has to
                           discover it by clicking. It is omitted entirely on columns that cannot
                           sort, where "none" would be the same false promise. *@
                        <th scope="col"
                            class="@HeaderClassFor(column)"
                            style="@WidthStyle(column)"
                            aria-sort="@AriaSortFor(column)">
                            @if (CanSort(column))
                            {
                                <button type="button" class="@SortButtonClass" @onclick="@(() => ToggleSortAsync(column))">
                                    @HeaderContent(column)

                                    @* The indicator is present on every sortable column and only
                                       carries a direction on the sorted one, so the header does
                                       not change width when the sort moves - which otherwise
                                       reflows the whole table under the pointer mid-click. *@
                                    <ZenIcon Path="@SortIconFor(column)" class="@SortIconClass(column)" />
                                </button>
                            }
                            else
                            {
                                @HeaderContent(column)
                            }
                        </th>
                    }
                </tr>
            </thead>

            <tbody class="divide-y divide-border">
                @if (IsLoading)
                {
                    @* Skeleton rows keep the table's real shape, so the page does not jump when
                       the data lands. A spinner in place of the body collapses the table to
                       nothing and then pushes everything below it back down. *@
                    @for (var i = 0; i < SkeletonRowCount; i++)
                    {
                        <tr>
                            @for (var c = 0; c < ColumnCount; c++)
                            {
                                <td class="@BodyCellClass">
                                    <ZenSkeleton Shape="ZenSkeletonShape.Text" />
                                </td>
                            }
                        </tr>
                    }
                }
                else if (ShowEmptyState)
                {
                    <tr>
                        @* zen-table-empty rather than a [colspan] selector, so the stacked mobile
                           layout can tell this cell from a detail cell - both span the table, and
                           only one of them should be centred. *@
                        <td colspan="@ColumnCount" class="zen-table-empty p-0">
                            @if (EmptyTemplate is not null)
                            {
                                @EmptyTemplate
                            }
                            else
                            {
                                <ZenEmptyState Title="@EmptyText"
                                               Description="@EmptyDescription"
                                               Icon="@EmptyIcon"
                                               Actions="EmptyActions" />
                            }
                        </td>
                    </tr>
                }
                else if (UseVirtualize)
                {
                    @* Spacers are <tr>s so the table stays a table: the framework's default <div>
                       spacer inside a <tbody> is invalid markup, and the browser hoists it out of
                       the table entirely - taking the scroll height with it. *@
                    @if (ItemsProvider is not null)
                    {
                        <Virtualize TItem="DisplayRow"
                                    @ref="_virtualize"
                                    ItemsProvider="_virtualRowsProvider"
                                    ItemContent="RowTemplate"
                                    Placeholder="PlaceholderTemplate"
                                    ItemSize="ItemSize"
                                    OverscanCount="OverscanCount"
                                    SpacerElement="tr" />
                    }
                    else
                    {
                        @* A Placeholder even for rows already in memory. <Virtualize> renders one
                           for every row it has not "loaded" yet - which, after a long jump, is
                           every row in view - and its default is a <div> of ItemSize height. A
                           <div> inside a <tbody> is wrapped by table layout and does not take
                           that height, and the framework then measures the gap between its
                           spacers, subtracts the height it assumed the placeholders had, and
                           divides: the row height it arrives at collapses to a few pixels, the
                           scroll box shrinks to a tenth of its length, and the view is left
                           showing a handful of rows over empty space. A <tr> of the same height
                           keeps the arithmetic true. *@
                        <Virtualize TItem="DisplayRow"
                                    @ref="_virtualize"
                                    Items="_rows"
                                    ItemContent="RowTemplate"
                                    Placeholder="PlaceholderTemplate"
                                    ItemSize="ItemSize"
                                    OverscanCount="OverscanCount"
                                    SpacerElement="tr" />
                    }
                }
                else
                {
                    @foreach (var row in _rows)
                    {
                        @RenderRow(row)
                    }
                }
            </tbody>
        </table>
    </div>

    @* The footer appears whenever paging is on at all, not only when there is more than one page.
       The page-size control is the reason: a table that fits on one page at 50 rows may not at
       10, and hiding the only way to find that out behind "there is already more than one page"
       is a chicken-and-egg. The page BUTTONS still only appear when there is somewhere to go. *@
    @if (EffectivePageSize > 0 && !Loading && !(_fetching && _lastFetch is null))
    {
        @* Named after the table, because a <nav> is a landmark and a page with two paged
           tables would otherwise offer a screen reader two landmarks called "Pagination" with
           nothing to tell them apart. *@
        <nav class="mt-3 flex flex-wrap items-center justify-between gap-x-4 gap-y-3" aria-label="@PagerLabel">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                @* aria-live, because the rows change without anything moving focus - a screen
                   reader user pressing Next would otherwise get no confirmation that anything
                   happened. The range and the total are both here, so it also answers "how far
                   through am I" without counting page buttons. *@
                <p class="text-sm text-content-muted" aria-live="polite">@PageSummary</p>

                @if (ShowPageSizeSelector && PageSizeChoices.Count > 0)
                {
                    @* A bare <select> rather than ZenSelect. ZenSelect is a form control: it
                       derives from ZenInputBase, picks up any cascading EditContext and registers
                       a field in it. A table dropped inside an EditForm would then have its page
                       size participate in that form's validation and dirty tracking, which is a
                       bug nobody would think to look for. This control edits the table's view,
                       not the user's data. *@
                    <label class="flex items-center gap-2 text-sm text-content-muted">
                        <span>Rows per page</span>

                        <select class="@PageSizeSelectClass"
                                value="@EffectivePageSize"
                                @onchange="HandlePageSizeChangedAsync">
                            @foreach (var size in PageSizeChoices)
                            {
                                <option value="@size" selected="@(size == EffectivePageSize)">@size</option>
                            }
                        </select>
                    </label>
                }
            </div>

            @if (PageCount > 1)
            {
                <div class="flex items-center gap-1">
                    <ZenButton Variant="ZenVariant.Ghost"
                               Size="ZenSize.Small"
                               Icon="@ZenIcons.ChevronLeft"
                               IconOnly="true"
                               AriaLabel="Previous page"
                               Disabled="@(CurrentPage <= 1)"
                               OnClick="@(() => GoToPageAsync(CurrentPage - 1))" />

                    @foreach (var (link, index) in PageLinks().Select((l, i) => (l, i)))
                    {
                        @if (link is { } pageNumber)
                        {
                            @* aria-current="page" is what tells a screen reader which button is
                               the one they are on. The colour alone says it to everyone else. *@
                            <ZenButton Variant="@(pageNumber == CurrentPage ? ZenVariant.Solid : ZenVariant.Ghost)"
                                       Intent="@(pageNumber == CurrentPage ? ZenIntent.Primary : ZenIntent.Neutral)"
                                       Size="ZenSize.Small"
                                       class="min-w-8 px-2 tabular-nums"
                                       aria-current="@(pageNumber == CurrentPage ? "page" : null)"
                                       aria-label="@($"Page {pageNumber}")"
                                       OnClick="@(() => GoToPageAsync(pageNumber))">
                                @pageNumber
                            </ZenButton>
                        }
                        else
                        {
                            @* Hidden from assistive technology: it is a gap, not a destination,
                               and "horizontal ellipsis" between two page numbers tells a screen
                               reader user nothing the summary has not already said. *@
                            <span class="px-1 text-sm text-content-subtle" aria-hidden="true">&hellip;</span>
                        }
                    }

                    <ZenButton Variant="ZenVariant.Ghost"
                               Size="ZenSize.Small"
                               Icon="@ZenIcons.ChevronRight"
                               IconOnly="true"
                               AriaLabel="Next page"
                               Disabled="@(CurrentPage >= PageCount)"
                               OnClick="@(() => GoToPageAsync(CurrentPage + 1))" />
                </div>
            }
        </nav>
    }
</ZenDefer>

@code {
    /// <summary>One row of the body as the table currently sees it.</summary>
    /// <remarks>
    /// Every kind of row lives in one flat list - data rows, tree rows, group headers - because
    /// that list is the single thing both the plain loop and <c>&lt;Virtualize&gt;</c> render.
    /// <paramref name="Index"/> is the row's position in the whole list, not in the DOM, which is
    /// what keeps ids and <c>aria-rowindex</c> correct once only a window of rows exists.
    /// </remarks>
    private abstract record DisplayRow(int Index);

    /// <summary>A data row.</summary>
    private sealed record ItemRow(TItem Item, int Depth, bool HasChildren, bool IsExpanded, int Index)
        : DisplayRow(Index);

    /// <summary>The header row that opens a group.</summary>
    private sealed record GroupRow(ZenTableGroup<TItem> Group, bool IsCollapsed, int Index)
        : DisplayRow(Index);

    /// <summary>The shape of the last provider request, so an unchanged view is not refetched.</summary>
    private sealed record FetchKey(int StartIndex, int? Count, string? SortName, bool SortDescending, int Version);

    private readonly List<ZenColumn<TItem>> _columns = [];
    private readonly HashSet<TItem> _expanded = [];
    private readonly HashSet<TItem> _detailsOpen = [];
    private readonly HashSet<object> _collapsedGroups = [];
    private readonly HashSet<object> _seenGroups = [];

    private static readonly int[] DefaultPageSizeOptions = [10, 25, 50, 100];

    /// <summary>Stands in for a null group key, which a <see cref="HashSet{T}"/> cannot hold.</summary>
    private static readonly object NullGroupKey = new();

    /// <summary>
    /// How many rows a virtualized table renders when there is no JavaScript to measure the
    /// viewport with - static SSR, and the prerender pass before the circuit connects.
    /// </summary>
    /// <remarks>
    /// Some rather than none, so a server-rendered page arrives with content and a crawler sees
    /// data. Not all of them, because the reason to virtualize is that "all of them" is too many
    /// to render - and that is at least as true on the server.
    /// </remarks>
    internal const int StaticVirtualRowCount = 50;

    private Virtualize<DisplayRow>? _virtualize;
    private readonly ItemsProviderDelegate<DisplayRow> _virtualRowsProvider;

    private CancellationTokenSource? _fetch;
    private FetchKey? _lastFetch;
    private int _refreshVersion;
    private FetchKey? _inFlight;
    private bool _fetching;
    private IReadOnlyList<TItem> _providerItems = [];
    private int _totalCount;

    /// <summary>
    /// Rows a virtualized provider has delivered, by index, so the picker's keyboard cursor can
    /// commit a row it moved onto by index before that row's markup existed.
    /// </summary>
    private readonly Dictionary<int, TItem> _loadedByIndex = [];

    /// <summary>What paging counts: items, or items plus collapsed group headers when grouped.</summary>
    private int _pagingTotal;

    /// <summary>Every row of the body before any static-render cut, for aria-rowcount.</summary>
    private int _rowTotal;

    /// <summary>Creates the table.</summary>
    public ZenTable() => _virtualRowsProvider = ProvideVirtualRowsAsync;

    /// <summary>The rows built by the current render pass, reused by everything that needs them.</summary>
    /// <remarks>
    /// Built once per pass rather than recomputed per call. Row styling asks which row is active,
    /// so a property that re-flattened the data each time would make rendering quadratic in the
    /// row count - and the keyboard would be navigating a list built from slightly different state
    /// than the one on screen.
    /// </remarks>
    private List<DisplayRow> _rows = [];

    /// <summary>The data rows of <see cref="_rows"/>, without the group headers.</summary>
    private List<ItemRow> _itemRows = [];

    private int _generation;
    private int _collectedGeneration = -1;

    private bool _seeded;
    private bool _hasFocus;
    private string? _focusedId;

    private ZenColumn<TItem>? _sortColumn;
    private bool _sortDescending;
    private int _page = 1;
    private int? _chosenPageSize;
    private int _lastPageSizeParameter;
    private TItem? _active;

    /// <inheritdoc />
    /// <remarks>
    /// Null for a flat table, which needs no JavaScript at all: it is a plain <c>&lt;table&gt;</c>
    /// and the browser already does everything. Only the treegrid loads a module, and only for
    /// <c>focusElement</c> - a roving tabindex that moves the attribute without moving DOM focus
    /// leaves the screen reader on the row the user has left.
    /// </remarks>
    protected override string? ModulePath =>
        Hierarchical ? "./_content/ZenithUI/js/zen-dom.js" : null;

    // ---- Data ---------------------------------------------------------------------------------

    /// <summary>The rows to render.</summary>
    [Parameter]
    public IEnumerable<TItem>? Items { get; set; }

    /// <summary>The <see cref="ZenColumn{TItem}"/> declarations.</summary>
    [Parameter]
    public RenderFragment? Columns { get; set; }

    /// <summary>
    /// A row's children, which turns the table into a <c>treegrid</c>.
    /// </summary>
    /// <remarks>
    /// Return <see langword="null"/> or an empty sequence for a leaf. Supplying this parameter at
    /// all is what switches on the hierarchy, the indentation and the ARIA that goes with them.
    /// </remarks>
    [Parameter]
    public Func<TItem, IEnumerable<TItem>?>? ChildrenProvider { get; set; }

    /// <summary>Rows to open on first render.</summary>
    [Parameter]
    public Func<TItem, bool>? IsInitiallyExpanded { get; set; }

    /// <summary>
    /// Loads rows on demand - a page at a time, or a window at a time when
    /// <see cref="Virtualize"/> is on. Use instead of <see cref="Items"/> when the data lives on a
    /// server.
    /// </summary>
    /// <remarks>
    /// The request carries the sorted column's <see cref="ZenColumn{TItem}.SortName"/>, and only
    /// columns that declare one are sortable: the server is doing the sorting, and a column it
    /// has no name for is a column it cannot sort. Requests are cancelled when superseded, so
    /// pass the token on to the query.
    /// <para>
    /// Selection compares rows with <see cref="object.Equals(object)"/>. Each request returns new
    /// instances, so give <c>TItem</c> value equality - a record, or an overridden
    /// <c>Equals</c> - or a selected row will not recognise itself on the next page load.
    /// </para>
    /// </remarks>
    [Parameter]
    public Func<ZenTableRequest, ValueTask<ZenTableResult<TItem>>>? ItemsProvider { get; set; }

    // ---- Virtualization -----------------------------------------------------------------------

    /// <summary>
    /// Render only the rows in view. For long tables; replaces paging.
    /// </summary>
    /// <remarks>
    /// Set <see cref="Height"/> as well, so the table scrolls inside its own box; without it the
    /// page is the scroll container. The stacked mobile layout is switched off while
    /// virtualizing, because it turns every row into a card of a different height and the
    /// scrollbar is sized from <see cref="ItemSize"/>.
    /// <para>
    /// Under static SSR, and during prerender, the first
    /// <c>50</c> rows are rendered - there is no JavaScript yet to measure the viewport with.
    /// </para>
    /// </remarks>
    [Parameter]
    public bool Virtualize { get; set; }

    /// <summary>
    /// A virtualized row's height in pixels, used to size the scrollbar before rows are measured.
    /// </summary>
    [Parameter]
    public float ItemSize { get; set; } = 40f;

    /// <summary>How many rows to render beyond each edge of the viewport.</summary>
    [Parameter]
    public int OverscanCount { get; set; } = 5;

    /// <summary>
    /// A CSS max-height for the table's own scroll box, for example <c>"28rem"</c>.
    /// </summary>
    /// <remarks>
    /// Setting it also makes the header sticky: a table that scrolls inside a box and loses its
    /// header on the first flick of the wheel is a table of unlabelled numbers.
    /// </remarks>
    [Parameter]
    public string? Height { get; set; }

    // ---- Grouping -----------------------------------------------------------------------------

    /// <summary>
    /// The value to group rows by. Each distinct value gets a header row, and groups are ordered
    /// by it.
    /// </summary>
    /// <remarks>
    /// Groups are ordered by their key, nulls first; the column sort then applies within each
    /// group. Cannot be combined with <see cref="ChildrenProvider"/> or
    /// <see cref="ItemsProvider"/>: the first is another way of nesting rows, and the second
    /// never has every row to group.
    /// </remarks>
    [Parameter]
    public Func<TItem, object?>? GroupBy { get; set; }

    /// <summary>The text shown for a group's key. Defaults to its <c>ToString()</c>.</summary>
    [Parameter]
    public Func<object?, string>? GroupText { get; set; }

    /// <summary>The header shown for rows whose key is null.</summary>
    [Parameter]
    public string UngroupedText { get; set; } = "(None)";

    /// <summary>
    /// Custom content for a group header, replacing the name and count.
    /// </summary>
    /// <remarks>
    /// Rendered inside the collapse button when groups are collapsible, so it must not itself
    /// contain anything interactive - a button inside a button is invalid, and neither one can be
    /// operated reliably.
    /// </remarks>
    [Parameter]
    public RenderFragment<ZenTableGroup<TItem>>? GroupHeaderTemplate { get; set; }

    /// <summary>Let the user collapse and expand groups.</summary>
    [Parameter]
    public bool GroupsCollapsible { get; set; } = true;

    /// <summary>Groups that start collapsed, by key.</summary>
    [Parameter]
    public Func<object?, bool>? IsGroupInitiallyCollapsed { get; set; }

    /// <summary>Order groups by descending key.</summary>
    [Parameter]
    public bool GroupDescending { get; set; }

    /// <summary>Set by <c>ZenLookup</c>, which hosts this table as its popup grid.</summary>
    [CascadingParameter]
    private ZenTablePicker<TItem>? Picker { get; set; }

    // ---- State --------------------------------------------------------------------------------

    /// <summary>Show skeleton rows instead of data.</summary>
    [Parameter]
    public bool Loading { get; set; }

    /// <summary>How many skeleton rows to show while loading.</summary>
    [Parameter]
    public int LoadingRowCount { get; set; } = 5;

    /// <summary>Headline for the empty state.</summary>
    [Parameter]
    public string EmptyText { get; set; } = "No data";

    /// <summary>
    /// A sentence below the headline explaining why the table is empty, or what to do next.
    /// </summary>
    /// <remarks>
    /// Worth filling in whenever the table can be empty for more than one reason. "No data" alone
    /// leaves a user who has just typed a filter unable to tell "nothing matched" from "nothing
    /// exists", and the two call for opposite actions.
    /// </remarks>
    [Parameter]
    public string? EmptyDescription { get; set; }

    /// <summary>An SVG path for the empty state's illustration. Null renders text only.</summary>
    [Parameter]
    public string? EmptyIcon { get; set; } = ZenIcons.Inbox;

    /// <summary>Buttons offering the way out of the empty state.</summary>
    [Parameter]
    public RenderFragment? EmptyActions { get; set; }

    /// <summary>Custom empty-state markup, replacing the whole default visual.</summary>
    [Parameter]
    public RenderFragment? EmptyTemplate { get; set; }

    /// <summary>Give each row a selection checkbox.</summary>
    [Parameter]
    public bool Selectable { get; set; }

    /// <summary>The selected rows.</summary>
    [Parameter]
    public IReadOnlyCollection<TItem>? SelectedItems { get; set; }

    /// <summary>Raised when the selection changes.</summary>
    [Parameter]
    public EventCallback<IReadOnlyCollection<TItem>> SelectedItemsChanged { get; set; }

    /// <summary>Text naming a row, used for its checkbox's accessible name.</summary>
    /// <remarks>
    /// Worth supplying whenever rows are selectable. Without it every checkbox is announced as
    /// "Select row", and a screen reader user hears the same phrase for each of them with nothing
    /// to tell them apart.
    /// </remarks>
    [Parameter]
    public Func<TItem, string>? RowText { get; set; }

    /// <summary>Raised when a row is clicked.</summary>
    [Parameter]
    public EventCallback<TItem> OnRowClick { get; set; }

    // ---- Detail rows --------------------------------------------------------------------------

    /// <summary>
    /// Expandable content for a row, rendered in its own row spanning every column.
    /// </summary>
    /// <remarks>
    /// Setting this adds a leading column of disclosure buttons. The content is arbitrary - a
    /// summary, a form, a chart, another <see cref="ZenTable{TItem}"/> - because it is given the
    /// full width of the table rather than a cell's.
    /// <para>
    /// It is rendered only while open. A hundred-row table therefore does not build a hundred
    /// hidden panels, and a detail that loads its own data does not load it a hundred times on
    /// first paint.
    /// </para>
    /// </remarks>
    [Parameter]
    public RenderFragment<TItem>? RowDetailTemplate { get; set; }

    /// <summary>
    /// Whether a particular row has detail worth opening. Defaults to all of them.
    /// </summary>
    /// <remarks>
    /// Rows that answer <see langword="false"/> get no button rather than a button that opens an
    /// empty panel - which is the more annoying of the two, because it costs a click to find out.
    /// </remarks>
    [Parameter]
    public Func<TItem, bool>? HasRowDetail { get; set; }

    /// <summary>Rows whose detail starts open.</summary>
    [Parameter]
    public Func<TItem, bool>? IsDetailInitiallyOpen { get; set; }

    /// <summary>Raised when a row's detail is opened or closed.</summary>
    [Parameter]
    public EventCallback<TItem> RowDetailToggled { get; set; }

    /// <summary>Extra classes for a row, by item - for status tinting.</summary>
    [Parameter]
    public Func<TItem, string?>? RowClass { get; set; }

    // ---- Paging -------------------------------------------------------------------------------

    /// <summary>Rows per page. Zero renders everything and hides the pager entirely.</summary>
    /// <remarks>
    /// The initial value. Once the user picks a size from the selector, their choice holds until
    /// this parameter is given a different value - at which point the parameter wins again. That
    /// is what lets the table be used without binding anything while still letting a consumer who
    /// does bind reset the view.
    /// </remarks>
    [Parameter]
    public int PageSize { get; set; }

    /// <summary>Raised when the user picks a different page size.</summary>
    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }

    /// <summary>The sizes offered by the selector.</summary>
    [Parameter]
    public IReadOnlyList<int>? PageSizeOptions { get; set; }

    /// <summary>Show the rows-per-page selector.</summary>
    [Parameter]
    public bool ShowPageSizeSelector { get; set; } = true;

    /// <summary>The current page, one-based.</summary>
    [Parameter]
    public int Page { get; set; }

    /// <summary>Raised when the page changes.</summary>
    [Parameter]
    public EventCallback<int> PageChanged { get; set; }

    /// <summary>
    /// How many page numbers to show either side of the current one.
    /// </summary>
    /// <remarks>
    /// The first and last pages are always shown regardless, because "go back to the start" and
    /// "jump to the end" are the two destinations people actually reach for.
    /// </remarks>
    [Parameter]
    public int PageLinkSiblings { get; set; } = 1;

    // ---- Appearance ---------------------------------------------------------------------------

    /// <summary>Accessible name for the table.</summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>Id of the element naming the table.</summary>
    [Parameter]
    public string? LabelledBy { get; set; }

    /// <summary>A visible caption, which also names the table.</summary>
    [Parameter]
    public string? Caption { get; set; }

    /// <summary>Row density.</summary>
    [Parameter]
    public ZenSize Size { get; set; } = ZenSize.Medium;

    /// <summary>Tint alternate rows.</summary>
    [Parameter]
    public bool Striped { get; set; }

    /// <summary>Tint the row under the pointer.</summary>
    [Parameter]
    public bool Hoverable { get; set; } = true;

    /// <summary>Surround the table with a border and a raised surface.</summary>
    [Parameter]
    public bool Bordered { get; set; } = true;

    /// <summary>
    /// Keep the header visible while the body scrolls.
    /// </summary>
    /// <remarks>
    /// It sticks to the nearest scrolling ancestor, which is the page unless the table is inside
    /// a scroll container of its own.
    /// </remarks>
    [Parameter]
    public bool StickyHeader { get; set; }

    /// <summary>
    /// Collapse each row into a stacked card below the <c>md</c> breakpoint.
    /// </summary>
    /// <remarks>
    /// On by default, because the alternative on a phone is a horizontal scrollbar that hides
    /// whichever column the user needs. Turn it off for a table that is genuinely a grid of
    /// numbers, where the column relationships are the point and stacking destroys them.
    /// </remarks>
    [Parameter]
    public bool ResponsiveCollapse { get; set; } = true;

    // ---- Column registration ------------------------------------------------------------------

    /// <summary>
    /// Called by a <see cref="ZenColumn{TItem}"/> as it receives its parameters.
    /// </summary>
    /// <remarks>
    /// The list is rebuilt per render pass rather than appended to for the life of the component,
    /// so a column added or removed by an <c>@@if</c> lands in document order rather than at the
    /// end. It is cleared by the first column of a new generation rather than before the cascade
    /// renders: if a pass somehow registers nothing, the table keeps the previous columns instead
    /// of rendering a header with none.
    /// </remarks>
    internal void Register(ZenColumn<TItem> column)
    {
        if (_collectedGeneration != _generation)
        {
            _collectedGeneration = _generation;
            _columns.Clear();
        }

        _columns.Add(column);
    }

    // ---- Rows ---------------------------------------------------------------------------------

    private bool Hierarchical => ChildrenProvider is not null;

    private int ColumnCount => _columns.Count + (Selectable ? 1 : 0) + (HasDetails ? 1 : 0);

    private bool Grouped => GroupBy is not null;

    private IReadOnlyList<TItem> Source =>
        ItemsProvider is not null
            ? _providerItems
            : Items as IReadOnlyList<TItem> ?? Items?.ToList() ?? [];

    /// <summary>
    /// Whether the body goes through <c>&lt;Virtualize&gt;</c>: asked for, and with a renderer
    /// that has JavaScript to measure the viewport with.
    /// </summary>
    private bool UseVirtualize => Virtualize && RendererInfo.IsInteractive;

    /// <summary>
    /// Loading as far as the markup is concerned: the caller says so, or the first page of a
    /// provider has not arrived.
    /// </summary>
    private bool IsLoading => Loading || _fetching;

    /// <summary>
    /// Skeleton rows match the page they replace, so paging through a server-backed table does
    /// not collapse the body to five rows and back on every click.
    /// </summary>
    private int SkeletonRowCount =>
        ItemsProvider is not null && _providerItems.Count > 0 ? _providerItems.Count : LoadingRowCount;

    /// <summary>
    /// A virtualized provider table never shows the empty state from here: until
    /// <c>&lt;Virtualize&gt;</c> has asked, the table does not know it is empty.
    /// </summary>
    private bool ShowEmptyState =>
        UseVirtualize && ItemsProvider is not null ? _lastFetch is not null && _totalCount == 0 : _rows.Count == 0;

    /// <summary>The number of rows paging counts: see <see cref="_pagingTotal"/>.</summary>
    private int PagingTotal => ItemsProvider is not null ? _totalCount : _pagingTotal;

    private int CurrentPage => Page > 0 ? Page : _page;

    /// <summary>The page size in force: the user's choice if they have made one, else the parameter.</summary>
    private int EffectivePageSize => _chosenPageSize ?? PageSize;

    /// <summary>
    /// The sizes offered by the selector, with the size actually in force guaranteed to be among
    /// them.
    /// </summary>
    /// <remarks>
    /// A consumer who sets <c>PageSize="15"</c> and leaves the options alone would otherwise get a
    /// select whose value matches none of its options, which browsers resolve by showing the first
    /// one - so the control would claim a page size the table is not using.
    /// </remarks>
    private IReadOnlyList<int> PageSizeChoices
    {
        get
        {
            var options = PageSizeOptions ?? DefaultPageSizeOptions;

            return options.Contains(EffectivePageSize)
                ? options
                : [.. options.Append(EffectivePageSize).Order()];
        }
    }

    private int PageCount => EffectivePageSize <= 0
        ? 1
        : Math.Max(1, (PagingTotal + EffectivePageSize - 1) / EffectivePageSize);

    /// <summary>
    /// The page numbers to draw, with <see langword="null"/> standing for a gap.
    /// </summary>
    /// <remarks>
    /// A gap of exactly one page is filled in rather than elided. An ellipsis hiding a single
    /// number is strictly worse than the number: it costs the same width, and it turns a
    /// one-click jump into a guess.
    /// </remarks>
    private IReadOnlyList<int?> PageLinks()
    {
        var total = PageCount;
        var current = Math.Clamp(CurrentPage, 1, total);
        var siblings = Math.Max(0, PageLinkSiblings);

        var wanted = new SortedSet<int> { 1, total };

        for (var page = current - siblings; page <= current + siblings; page++)
        {
            if (page >= 1 && page <= total)
            {
                wanted.Add(page);
            }
        }

        var links = new List<int?>(wanted.Count);
        var previous = 0;

        foreach (var page in wanted)
        {
            if (previous > 0 && page - previous > 1)
            {
                if (page - previous == 2)
                {
                    links.Add(previous + 1);
                }
                else
                {
                    links.Add(null);
                }
            }

            links.Add(page);
            previous = page;
        }

        return links;
    }

    /// <summary>
    /// Builds the rows on screen: sorted, grouped, paged, then flattened through whatever is
    /// expanded.
    /// </summary>
    /// <remarks>
    /// That order matters. Paging after flattening would let one expanded row push its siblings
    /// onto the next page, so opening a row would appear to delete the ones below it. Pages are
    /// counted in top-level rows, and a subtree travels with its parent.
    /// <para>
    /// A provider's rows arrive already sorted and already paged - that was the request - so they
    /// are only flattened.
    /// </para>
    /// </remarks>
    private void BuildRows()
    {
        SeedInitialExpansion();

        var roots = Sorted(Source);
        var rows = new List<DisplayRow>(roots.Count);

        if (Grouped)
        {
            BuildGroupedRows(roots, rows);
        }
        else
        {
            _pagingTotal = roots.Count;

            if (EffectivePageSize > 0 && ItemsProvider is null)
            {
                roots = roots.Skip((Math.Clamp(CurrentPage, 1, PageCount) - 1) * EffectivePageSize)
                    .Take(EffectivePageSize)
                    .ToList();
            }

            Flatten(roots, 0, rows);
        }

        _rowTotal = rows.Count;

        // Virtualizing with no JavaScript: the first rows as plain markup. Cut after flattening, so
        // the total above still counts every row for aria-rowcount.
        if (Virtualize && !UseVirtualize && ItemsProvider is null && rows.Count > StaticVirtualRowCount)
        {
            rows.RemoveRange(StaticVirtualRowCount, rows.Count - StaticVirtualRowCount);
        }

        _rows = rows;
        _itemRows = rows.OfType<ItemRow>().ToList();
    }

    private void Flatten(IReadOnlyList<TItem> items, int depth, List<DisplayRow> into)
    {
        foreach (var item in items)
        {
            var children = ChildrenProvider?.Invoke(item);
            var childList = children is null ? [] : Sorted(children);
            var expanded = _expanded.Contains(item);

            into.Add(new ItemRow(item, depth, childList.Count > 0, expanded, into.Count));

            if (expanded && childList.Count > 0)
            {
                Flatten(childList, depth + 1, into);
            }
        }
    }

    /// <summary>
    /// Splits the sorted rows into groups, then pages across them.
    /// </summary>
    /// <remarks>
    /// Paging counts what the user can see a row for: every row of an expanded group, and one
    /// for each collapsed group's header. Counting group headers everywhere would make pages
    /// shorter the more groups they cross, and counting a collapsed group's hidden rows would
    /// produce pages that are nothing but headers.
    /// <para>
    /// A group that runs over a page boundary repeats its header at the top of the next page.
    /// Without it the rows at the top of page two belong to a group whose name is on page one.
    /// </para>
    /// </remarks>
    private void BuildGroupedRows(List<TItem> sorted, List<DisplayRow> into)
    {
        var groups = Groups(sorted);
        var entries = new List<(ZenTableGroup<TItem> Group, bool Collapsed, TItem? Item)>(sorted.Count);

        foreach (var group in groups)
        {
            var collapsed = IsGroupCollapsed(group);

            if (collapsed)
            {
                entries.Add((group, true, default));
                continue;
            }

            foreach (var item in group.Items)
            {
                entries.Add((group, false, item));
            }
        }

        _pagingTotal = entries.Count;

        IEnumerable<(ZenTableGroup<TItem> Group, bool Collapsed, TItem? Item)> window = entries;

        if (EffectivePageSize > 0)
        {
            window = entries.Skip((Math.Clamp(CurrentPage, 1, PageCount) - 1) * EffectivePageSize)
                .Take(EffectivePageSize);
        }

        ZenTableGroup<TItem>? current = null;

        foreach (var (group, collapsed, item) in window)
        {
            if (!ReferenceEquals(group, current))
            {
                into.Add(new GroupRow(group, collapsed, into.Count));
                current = group;
            }

            if (!collapsed)
            {
                into.Add(new ItemRow(item!, 0, false, false, into.Count));
            }
        }
    }

    /// <summary>The groups, in key order, each holding its rows in the current sort order.</summary>
    private List<ZenTableGroup<TItem>> Groups(List<TItem> sorted)
    {
        var buckets = new Dictionary<object, (object? Key, List<TItem> Items)>();
        var order = new List<object>();

        foreach (var item in sorted)
        {
            var key = GroupBy!(item);
            var slot = key ?? NullGroupKey;

            if (!buckets.TryGetValue(slot, out var bucket))
            {
                bucket = (key, []);
                buckets[slot] = bucket;
                order.Add(slot);
            }

            bucket.Items.Add(item);
        }

        var comparer = Comparer<object?>.Create(CompareValues);
        var keys = GroupDescending
            ? order.OrderByDescending(slot => buckets[slot].Key, comparer)
            : order.OrderBy(slot => buckets[slot].Key, comparer);

        var groups = new List<ZenTableGroup<TItem>>(order.Count);

        foreach (var slot in keys)
        {
            var (key, items) = buckets[slot];
            var text = key is null ? UngroupedText : GroupText?.Invoke(key) ?? key.ToString() ?? UngroupedText;

            groups.Add(new ZenTableGroup<TItem>(key, text, items));
        }

        return groups;
    }

    /// <summary>
    /// Whether a group is collapsed, seeding it from <see cref="IsGroupInitiallyCollapsed"/> the
    /// first time the group is seen.
    /// </summary>
    /// <remarks>
    /// Seeded per group rather than once for the table, because groups come and go with the data:
    /// a group that first appears after a refresh should still start the way the caller asked.
    /// Seeded only once per group, so a group the user has opened stays open.
    /// </remarks>
    private bool IsGroupCollapsed(ZenTableGroup<TItem> group)
    {
        var slot = group.Key ?? NullGroupKey;

        if (_seenGroups.Add(slot) && IsGroupInitiallyCollapsed?.Invoke(group.Key) == true)
        {
            _collapsedGroups.Add(slot);
        }

        return GroupsCollapsible && _collapsedGroups.Contains(slot);
    }

    private void ToggleGroup(ZenTableGroup<TItem> group)
    {
        var slot = group.Key ?? NullGroupKey;

        if (!_collapsedGroups.Remove(slot))
        {
            _collapsedGroups.Add(slot);
        }
    }

    /// <summary>
    /// Applies the current sort, at every level of the hierarchy.
    /// </summary>
    /// <remarks>
    /// Sorting only the roots would leave children in their original order under sorted parents,
    /// which reads as the sort having partly failed.
    /// </remarks>
    private List<TItem> Sorted(IEnumerable<TItem> items)
    {
        // A provider sorted on the server; re-sorting its page here would reorder one page of a
        // sort that spans all of them.
        if (ItemsProvider is not null || _sortColumn?.SortKey is not { } key)
        {
            return items.ToList();
        }

        var comparer = Comparer<object?>.Create(CompareValues);

        return _sortDescending
            ? items.OrderByDescending(key, comparer).ToList()
            : items.OrderBy(key, comparer).ToList();
    }

    /// <summary>
    /// Orders two cell values, putting nulls first.
    /// </summary>
    /// <remarks>
    /// Nulls sort to one end rather than being treated as equal to everything, which would make
    /// the sort unstable in a way that looks random. First rather than last because a null is
    /// usually "not filled in yet", and the rows that need attention are the ones worth surfacing.
    /// </remarks>
    private static int CompareValues(object? left, object? right) => (left, right) switch
    {
        (null, null) => 0,
        (null, _) => -1,
        (_, null) => 1,
        _ => Comparer<object>.Default.Compare(left, right),
    };

    private void SeedInitialExpansion()
    {
        if (_seeded || Items is null)
        {
            return;
        }

        if (IsDetailInitiallyOpen is not null)
        {
            foreach (var item in Items.Where(IsDetailInitiallyOpen))
            {
                _detailsOpen.Add(item);
            }
        }

        if (IsInitiallyExpanded is null || ChildrenProvider is null)
        {
            // Nothing more to seed, but the pass still counts: re-running it later would reopen
            // whatever the user has since closed.
            _seeded = true;
            return;
        }

        _seeded = true;
        Seed(Items);

        void Seed(IEnumerable<TItem> items)
        {
            foreach (var item in items)
            {
                if (!IsInitiallyExpanded(item))
                {
                    continue;
                }

                _expanded.Add(item);

                if (ChildrenProvider(item) is { } children)
                {
                    Seed(children);
                }
            }
        }
    }

    // ---- Interaction --------------------------------------------------------------------------

    /// <summary>
    /// Cycles a column through ascending, descending and unsorted.
    /// </summary>
    /// <remarks>
    /// The third state is not decoration. The order the data arrived in carries information -
    /// it is very often "newest first" from the server - and a table that can only toggle between
    /// two sorts gives the user no way back to it short of reloading the page.
    /// </remarks>
    private async Task ToggleSortAsync(ZenColumn<TItem> column)
    {
        if (_sortColumn != column)
        {
            _sortColumn = column;
            _sortDescending = false;
        }
        else if (!_sortDescending)
        {
            _sortDescending = true;
        }
        else
        {
            _sortColumn = null;
            _sortDescending = false;
        }

        // Re-sorting reshuffles which rows fall on which page, and the row the user was looking at
        // is no longer where they left it. Returning to the first page is the only position that
        // means the same thing before and after.
        await GoToPageAsync(1);
        await ReloadAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        var target = Math.Clamp(page, 1, PageCount);

        if (target == CurrentPage)
        {
            return;
        }

        _page = target;
        await PageChanged.InvokeAsync(target);
        await ReloadAsync();
    }

    /// <inheritdoc />
    /// <remarks>
    /// The user's page-size choice is dropped whenever the <see cref="PageSize"/> parameter is
    /// given a new value, so a consumer that binds it can reset the view - while a consumer that
    /// sets it once and never touches it does not have their user's choice overwritten on every
    /// re-render.
    /// <para>
    /// Contradictory parameters throw rather than being quietly resolved. Each pair below is two
    /// answers to the same question, and silently preferring one would ship a table that ignores
    /// half of what the page asked for.
    /// </para>
    /// </remarks>
    protected override async Task OnParametersSetAsync()
    {
        ValidateParameters();

        if (PageSize != _lastPageSizeParameter)
        {
            _lastPageSizeParameter = PageSize;
            _chosenPageSize = null;
        }

        // A page that swaps the provider for Items (or back) must not keep rows from the old one.
        if (ItemsProvider is null && _lastFetch is not null)
        {
            _lastFetch = null;
            _providerItems = [];
            _totalCount = 0;
        }

        await EnsureDataAsync();
    }

    private void ValidateParameters()
    {
        if (Items is not null && ItemsProvider is not null)
        {
            throw new InvalidOperationException(
                $"{nameof(ZenTable<TItem>)} takes {nameof(Items)} or {nameof(ItemsProvider)}, not both.");
        }

        if (ItemsProvider is not null && ChildrenProvider is not null)
        {
            throw new InvalidOperationException(
                $"{nameof(ZenTable<TItem>)} cannot combine {nameof(ItemsProvider)} with {nameof(ChildrenProvider)}: " +
                "a hierarchy has to be walked in full, and a provider only ever returns a window of it.");
        }

        if (GroupBy is not null && ChildrenProvider is not null)
        {
            throw new InvalidOperationException(
                $"{nameof(ZenTable<TItem>)} cannot combine {nameof(GroupBy)} with {nameof(ChildrenProvider)}: " +
                "both nest rows, and a row cannot sit at two depths at once.");
        }

        if (GroupBy is not null && ItemsProvider is not null)
        {
            throw new InvalidOperationException(
                $"{nameof(ZenTable<TItem>)} cannot combine {nameof(GroupBy)} with {nameof(ItemsProvider)}: " +
                "grouping needs every row, and a provider only returns a window of them.");
        }

        if (Virtualize && PageSize > 0)
        {
            throw new InvalidOperationException(
                $"{nameof(ZenTable<TItem>)} cannot both {nameof(Virtualize)} and page. " +
                $"They are alternatives - set {nameof(PageSize)} to 0 to virtualize.");
        }
    }

    // ---- Provider data ------------------------------------------------------------------------

    /// <summary>
    /// Reloads the rows from <see cref="ItemsProvider"/>, keeping the current sort and page.
    /// </summary>
    /// <remarks>
    /// For data that changed on the server - after a save, or when a filter outside the table
    /// changed what the provider returns. Does nothing for a table given <see cref="Items"/>, which
    /// re-reads them on every render anyway. Call it from the component's own dispatcher, as with
    /// any method that renders: from an event handler, or through <c>InvokeAsync</c>.
    /// </remarks>
    public async Task RefreshDataAsync()
    {
        if (ItemsProvider is null)
        {
            return;
        }

        _refreshVersion++;

        if (UseVirtualize)
        {
            // An empty table rendered its empty state instead of the <Virtualize>, so there is no
            // live instance to refresh. Forgetting the last result brings a new one back, and a
            // new one asks for its first window by itself.
            var hadVirtualize = !ShowEmptyState && _virtualize is not null;

            _lastFetch = null;
            _loadedByIndex.Clear();

            if (hadVirtualize)
            {
                await _virtualize!.RefreshDataAsync();
            }

            StateHasChanged();
            return;
        }

        var load = EnsureDataAsync();
        StateHasChanged();
        await load;
        StateHasChanged();
    }

    /// <summary>
    /// Returns to the first page, for an owner whose query has changed what the rows are.
    /// </summary>
    internal async Task ResetToFirstPageAsync()
    {
        _page = 1;

        if (Page > 1)
        {
            await PageChanged.InvokeAsync(1);
        }
    }

    /// <summary>Re-requests the current view after a sort, page or page-size change.</summary>
    private async Task ReloadAsync()
    {
        if (ItemsProvider is null)
        {
            return;
        }

        if (UseVirtualize)
        {
            _loadedByIndex.Clear();

            if (_virtualize is not null)
            {
                await _virtualize.RefreshDataAsync();
            }

            return;
        }

        await EnsureDataAsync();
    }

    /// <summary>
    /// Asks the provider for the current view, unless that exact view is already loaded or
    /// already on its way.
    /// </summary>
    /// <remarks>
    /// Keyed on the request rather than triggered per event, because the same change arrives by
    /// more than one route - a page button raises PageChanged, the parent re-renders and hands the
    /// new Page back as a parameter - and fetching once per route would load every page twice.
    /// </remarks>
    private async Task EnsureDataAsync()
    {
        if (ItemsProvider is null || UseVirtualize)
        {
            return;
        }

        var paged = EffectivePageSize > 0;
        var start = paged ? (Math.Max(CurrentPage, 1) - 1) * EffectivePageSize : 0;
        int? count = paged ? EffectivePageSize : Virtualize ? StaticVirtualRowCount : null;
        var key = new FetchKey(start, count, _sortColumn?.SortName, _sortDescending, _refreshVersion);

        if (key == _lastFetch || key == _inFlight)
        {
            return;
        }

        // Cancel the request in flight. A slow response for page 2 landing after a fast one for
        // page 3 would otherwise put page 2's rows under a pager that says 3.
        _fetch?.Cancel();
        _fetch?.Dispose();
        _fetch = new CancellationTokenSource();

        var token = _fetch.Token;

        _inFlight = key;
        _fetching = true;

        try
        {
            var result = await ItemsProvider(
                new ZenTableRequest(key.StartIndex, key.Count, key.SortName, key.SortDescending, token));

            if (token.IsCancellationRequested)
            {
                return;
            }

            _providerItems = result.Items;
            _totalCount = result.TotalCount;
            _lastFetch = key;
        }
        catch (OperationCanceledException)
        {
            // Superseded. The newer request owns the loading state now.
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _inFlight = null;
                _fetching = false;
            }
        }
    }

    /// <summary>The virtualized body's source when the rows come from a provider.</summary>
    private async ValueTask<ItemsProviderResult<DisplayRow>> ProvideVirtualRowsAsync(ItemsProviderRequest request)
    {
        if (ItemsProvider is null)
        {
            return new ItemsProviderResult<DisplayRow>([], 0);
        }

        var result = await ItemsProvider(new ZenTableRequest(
            request.StartIndex,
            request.Count,
            _sortColumn?.SortName,
            _sortDescending,
            request.CancellationToken));

        var rows = new List<DisplayRow>(result.Items.Count);

        for (var i = 0; i < result.Items.Count; i++)
        {
            var index = request.StartIndex + i;

            _loadedByIndex[index] = result.Items[i];
            rows.Add(new ItemRow(result.Items[i], 0, false, false, index));
        }

        // The table's own markup depends on the total - aria-rowcount, and the empty state - so
        // it re-renders when that changes. <Virtualize> does not refetch on a parent render, so
        // this cannot loop.
        var changed = _lastFetch is null || _totalCount != result.TotalCount;

        _totalCount = result.TotalCount;
        _lastFetch ??= new FetchKey(0, null, _sortColumn?.SortName, _sortDescending, _refreshVersion);

        if (changed)
        {
            StateHasChanged();
        }

        return new ItemsProviderResult<DisplayRow>(rows, result.TotalCount);
    }

    /// <summary>
    /// A virtualized provider row that has not arrived yet: a skeleton the height of a row.
    /// </summary>
    private RenderFragment<PlaceholderContext> PlaceholderTemplate => context => __builder =>
    {
        <tr aria-rowindex="@(context.Index + 2)" style="@RowHeightStyle">
            @for (var c = 0; c < ColumnCount; c++)
            {
                <td class="@BodyCellClass">
                    <ZenSkeleton Shape="ZenSkeletonShape.Text" />
                </td>
            }
        </tr>
    };

    /// <summary>
    /// Applies a new page size, keeping the row currently at the top of the page in view.
    /// </summary>
    /// <remarks>
    /// Jumping back to page 1 is the usual implementation and it is quietly hostile: someone who
    /// has paged to row 400 and then asks for more rows per page is asking to see more of where
    /// they are, not to be sent back to the beginning. The first visible row is the anchor, so
    /// the view widens around it.
    /// </remarks>
    private async Task HandlePageSizeChangedAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out var size)
            || size <= 0)
        {
            return;
        }

        var firstRowIndex = (Math.Clamp(CurrentPage, 1, PageCount) - 1) * EffectivePageSize;

        _chosenPageSize = size;

        await PageSizeChanged.InvokeAsync(size);
        await GoToPageAsync((firstRowIndex / size) + 1);
        await ReloadAsync();
    }

    // ---- Detail rows --------------------------------------------------------------------------

    private bool HasDetails => RowDetailTemplate is not null;

    private bool HasDetailFor(TItem item) => HasRowDetail?.Invoke(item) ?? true;

    private bool IsDetailOpen(TItem item) => _detailsOpen.Contains(item);

    private async Task ToggleDetailAsync(TItem item)
    {
        _active = item;

        if (!_detailsOpen.Remove(item))
        {
            _detailsOpen.Add(item);
        }

        await RowDetailToggled.InvokeAsync(item);
    }

    /// <summary>The element id of a row's detail panel, so its button can point at it.</summary>
    private string DetailRowId(int index) => $"{Id}-detail-{index}";

    private void ToggleExpanded(TItem item)
    {
        _active = item;

        if (!_expanded.Remove(item))
        {
            _expanded.Add(item);
        }
    }

    private bool IsSelected(TItem item) => SelectedItems?.Contains(item) ?? false;

    private async Task ToggleSelectionAsync(TItem item)
    {
        var next = new List<TItem>(SelectedItems ?? []);

        if (!next.Remove(item))
        {
            next.Add(item);
        }

        await SelectedItemsChanged.InvokeAsync(next);
    }

    /// <summary>The rows the select-all box governs: the ones currently on screen.</summary>
    /// <remarks>
    /// The page, not the dataset. A table only knows the items it was handed, and a box that
    /// silently selects rows the user has never seen is how a bulk delete takes out more than it
    /// was meant to.
    /// </remarks>
    private List<TItem> PageItems => _itemRows.ConvertAll(r => r.Item);

    private bool AllOnPageSelected
    {
        get
        {
            var page = PageItems;
            return page.Count > 0 && page.TrueForAll(IsSelected);
        }
    }

    private bool SomeOnPageSelected => PageItems.Exists(IsSelected);

    private async Task ToggleAllAsync(bool selected)
    {
        var page = PageItems;
        var next = new List<TItem>(SelectedItems ?? []);

        foreach (var item in page)
        {
            next.Remove(item);
        }

        if (selected)
        {
            next.AddRange(page);
        }

        await SelectedItemsChanged.InvokeAsync(next);
    }

    private async Task RowClickedAsync(ItemRow row)
    {
        _active = row.Item;

        if (Picker is not null)
        {
            await Picker.RowClicked(row.Item, row.Index);
        }

        if (OnRowClick.HasDelegate)
        {
            await OnRowClick.InvokeAsync(row.Item);
        }
    }

    private bool IsActive(TItem item)
    {
        if (_active is not null)
        {
            return EqualityComparer<TItem>.Default.Equals(_active, item);
        }

        return _itemRows.Count > 0 && EqualityComparer<TItem>.Default.Equals(_itemRows[0].Item, item);
    }

    /// <summary>
    /// The treegrid's keyboard contract.
    /// </summary>
    /// <remarks>
    /// Rows are the unit of navigation. Cells are not navigable with the arrow keys, because Left
    /// and Right are what expand and collapse the hierarchy - the behaviour a treegrid exists for.
    /// Interactive cell content stays reachable with Tab.
    /// <para>
    /// A flat table handles no keys at all. It is a plain table, the browser already lets a screen
    /// reader walk it, and intercepting arrow keys there would break that.
    /// </para>
    /// </remarks>
    private async Task HandleKeyDownAsync(KeyboardEventArgs args)
    {
        if (!Hierarchical)
        {
            return;
        }

        var rows = _itemRows;

        if (rows.Count == 0)
        {
            return;
        }

        var index = Math.Max(0, rows.FindIndex(r => EqualityComparer<TItem>.Default.Equals(r.Item, _active)));
        var current = rows[index];

        switch (args.Key)
        {
            case "ArrowDown":
                _active = rows[Math.Min(index + 1, rows.Count - 1)].Item;
                break;

            case "ArrowUp":
                _active = rows[Math.Max(index - 1, 0)].Item;
                break;

            case "ArrowRight":
                if (current.HasChildren && !current.IsExpanded)
                {
                    ToggleExpanded(current.Item);
                }
                else if (current.IsExpanded && index + 1 < rows.Count)
                {
                    _active = rows[index + 1].Item;
                }

                break;

            case "ArrowLeft":
                if (current.IsExpanded)
                {
                    ToggleExpanded(current.Item);
                }
                else
                {
                    // Climbing by depth rather than by a stored parent reference: the first row
                    // above this one that is shallower is its parent, by construction of the
                    // flattening.
                    for (var i = index - 1; i >= 0; i--)
                    {
                        if (rows[i].Depth < current.Depth)
                        {
                            _active = rows[i].Item;
                            break;
                        }
                    }
                }

                break;

            case "Home":
                _active = rows[0].Item;
                break;

            case "End":
                _active = rows[^1].Item;
                break;

            case " ":
                if (Selectable)
                {
                    await ToggleSelectionAsync(current.Item);
                }

                break;

            default:
                return;
        }
    }

    /// <inheritdoc />
    /// <remarks>
    /// A provider request still in flight when the table goes away is cancelled, so a query that
    /// honours the token stops rather than finishing for a table nobody can see.
    /// </remarks>
    protected override async ValueTask DisposeAsyncCore()
    {
        _fetch?.Cancel();
        _fetch?.Dispose();
        _fetch = null;

        await base.DisposeAsyncCore();
    }

    /// <inheritdoc />
    /// <remarks>
    /// Moving focus after the render rather than in the key handler, for the same reason ZenTree
    /// does: ArrowRight expands a row and descends into a child that did not exist in the DOM when
    /// the key arrived. Gated on the table already holding focus, so a page containing a treegrid
    /// does not steal focus on its first render.
    /// </remarks>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        Picker?.Rendered?.Invoke();

        if (!Hierarchical || !_hasFocus || _active is null || !IsJsReady)
        {
            return;
        }

        var row = _itemRows.Find(r => EqualityComparer<TItem>.Default.Equals(r.Item, _active));

        if (row is null)
        {
            return;
        }

        var rowId = RowId(row.Index);

        if (rowId == _focusedId)
        {
            return;
        }

        _focusedId = rowId;
        await InvokeModuleVoidAsync("focusElement", rowId);
    }

    // ---- Row markup ---------------------------------------------------------------------------

    /// <summary>The per-row markup, as <c>&lt;Virtualize&gt;</c> wants it.</summary>
    private RenderFragment<DisplayRow> RowTemplate => RenderRow;

    /// <summary>
    /// One row of the body - a group header, or a data row followed by its detail row when open.
    /// </summary>
    /// <remarks>
    /// One fragment serves both the plain loop and <c>&lt;Virtualize&gt;</c>, so the two bodies
    /// cannot drift apart: a fix made to a row is made to both.
    /// </remarks>
    private RenderFragment RenderRow(DisplayRow displayRow) => __builder =>
    {
        if (displayRow is GroupRow groupRow)
        {
            var group = groupRow.Group;

            <tr id="@RowId(groupRow.Index)"
                class="zen-table-group bg-surface-sunken"
                style="@(UseVirtualize ? RowHeightStyle : null)"
                aria-rowindex="@AriaRowIndexFor(groupRow)">
                @* A header cell scoped to the row group, so a screen reader reading a cell below
                   announces the group it belongs to, the way it announces the column. *@
                <th colspan="@ColumnCount" scope="rowgroup" class="@GroupCellClass">
                    <div class="flex items-center gap-2">
                        @if (Selectable)
                        {
                            @* The whole group, including rows on other pages and rows hidden by a
                               collapse. That is broader than select-all, which stops at the page -
                               and deliberately so: the header states how many rows it holds, so
                               the scope of the click is on screen before it is made. *@
                            <ZenCheckbox Value="@AllInGroupSelected(group)"
                                         ValueChanged="@((bool selected) => ToggleGroupSelectionAsync(group, selected))"
                                         Indeterminate="@(SomeInGroupSelected(group) && !AllInGroupSelected(group))"
                                         aria-label="@($"Select all rows in {group.Text}")" />
                        }

                        @if (GroupsCollapsible)
                        {
                            <button type="button"
                                    class="@GroupToggleClass"
                                    aria-expanded="@(groupRow.IsCollapsed ? "false" : "true")"
                                    @onclick="@(() => ToggleGroup(group))">
                                <ZenIcon Path="@ZenIcons.ChevronRight" class="@GroupChevronClass(groupRow.IsCollapsed)" />
                                @GroupLabel(group)
                            </button>
                        }
                        else
                        {
                            <span class="inline-flex items-center gap-2">@GroupLabel(group)</span>
                        }
                    </div>
                </th>
            </tr>

            return;
        }

        var row = (ItemRow)displayRow;

        <tr id="@RowId(row.Index)"
            class="@RowClassFor(row)"
            style="@(UseVirtualize ? RowHeightStyle : null)"
            aria-rowindex="@AriaRowIndexFor(row)"
            aria-level="@(Hierarchical ? row.Depth + 1 : null)"
            aria-expanded="@AriaExpandedFor(row)"
            aria-selected="@AriaSelectedFor(row)"
            tabindex="@(Hierarchical ? (IsActive(row.Item) ? 0 : -1) : null)"
            @onclick="@(() => RowClickedAsync(row))"
            @attributes="PickerRowAttributes(row)">
            @if (HasDetails)
            {
                <td class="@($"{BodyCellClass} w-px")" @onclick:stopPropagation="true">
                    @if (HasDetailFor(row.Item))
                    {
                        @* A disclosure button, which is why this stays a plain
                           table: aria-expanded on a button is valid markup
                           anywhere, so opening a detail row costs no role claim.

                           Kept in the tab order even inside a treegrid, on the
                           same reasoning as the selection checkbox - Left and
                           Right already belong to the hierarchy, so there is no
                           arrow key left to reach this with. *@
                        <button type="button"
                                class="@DetailToggleClass"
                                aria-expanded="@(IsDetailOpen(row.Item) ? "true" : "false")"
                                aria-controls="@(IsDetailOpen(row.Item) ? DetailRowId(row.Index) : null)"
                                aria-label="@($"Details for {RowLabel(row)}")"
                                @onclick="@(() => ToggleDetailAsync(row.Item))">
                            <ZenIcon Path="@ZenIcons.ChevronRight" class="@DetailChevronClass(row.Item)" />
                        </button>
                    }
                </td>
            }

            @if (Selectable)
            {
                @* Kept in the tab order even inside the treegrid, where the
                   pattern would have every cell control at tabindex -1. Losing
                   keyboard access to selection is a worse failure than an extra
                   tab stop per row, and there is no arrow key left to reach it
                   with - Left and Right are spoken for by the hierarchy. *@
                <td class="@($"{BodyCellClass} w-px")" @onclick:stopPropagation="true">
                    <ZenCheckbox Value="@IsSelected(row.Item)"
                                 ValueChanged="@(_ => ToggleSelectionAsync(row.Item))"
                                 aria-label="@($"Select {RowLabel(row)}")" />
                </td>
            }

            @for (var index = 0; index < _columns.Count; index++)
            {
                var column = _columns[index];
                var first = index == 0;

                @* data-label is what the stacked mobile layout prints in front of
                   each value, because the header row is off screen there. It is a
                   plain attribute rather than a duplicated <span>, so the label
                   exists exactly once in the DOM and a screen reader - which
                   still has the real header association - never hears it twice.

                   The first cell carries an id in a picker, because that is what the
                   text field's aria-activedescendant names: the grid-popup pattern
                   points at a cell, and the row's aria-selected carries the choice. *@
                <td id="@(first && Picker is not null ? CellId(row.Index) : null)"
                    class="@BodyCellClassFor(column)"
                    data-label="@column.Title"
                    style="@(first && Hierarchical ? $"--zen-depth: {row.Depth}" : null)"
                    @onclick:stopPropagation="column.Interactive"
                    @onkeydown:stopPropagation="column.Interactive">
                    @if (first && Hierarchical)
                    {
                        <div class="zen-indent flex items-center gap-1.5">
                            @if (row.HasChildren)
                            {
                                <button type="button"
                                        class="grid size-5 shrink-0 place-items-center rounded-zen-sm text-content-subtle"
                                        tabindex="-1"
                                        aria-hidden="true"
                                        @onclick="@(() => ToggleExpanded(row.Item))"
                                        @onclick:stopPropagation="true">
                                    <ZenIcon Path="@ZenIcons.ChevronRight"
                                             class="@($"size-4 transition-transform {(row.IsExpanded ? "rotate-90" : null)}")" />
                                </button>
                            }
                            else
                            {
                                <span class="size-5 shrink-0" aria-hidden="true"></span>
                            }

                            <span class="min-w-0">@CellContent(column, row.Item)</span>
                        </div>
                    }
                    else
                    {
                        @CellContent(column, row.Item)
                    }
                </td>
            }
        </tr>

        @if (HasDetails && IsDetailOpen(row.Item))
        {
            @* A sibling row rather than content nested inside the data row. A
               <tr> cannot contain another <tr>, and a detail panel placed inside
               a <td> would be constrained by that column's width - which is the
               one thing a panel meant to hold a whole table must not be.

               It is rendered only while open, so a hundred-row table does not
               build a hundred hidden panels, and a detail that fetches its own
               data does not fetch it a hundred times. *@
            <tr id="@DetailRowId(row.Index)" class="@DetailRowClass">
                <td colspan="@ColumnCount" class="zen-table-detail px-4 py-4">
                    @RowDetailTemplate!(row.Item)
                </td>
            </tr>
        }
    };

    /// <summary>A group's name and row count, or the caller's template.</summary>
    private RenderFragment GroupLabel(ZenTableGroup<TItem> group) => __builder =>
    {
        if (GroupHeaderTemplate is not null)
        {
            <span class="inline-flex min-w-0 items-center gap-2">@GroupHeaderTemplate(group)</span>
        }
        else
        {
            <span class="font-medium text-content">@group.Text</span>

            @* The count is a number to the eye and "12 rows" to a screen reader. A bare "12"
               read out after the group name gives no hint what it is counting. *@
            <span class="rounded-full bg-surface-raised px-2 py-0.5 text-xs font-normal text-content-muted tabular-nums">
                @group.Count<span class="zen-sr-only">@(group.Count == 1 ? " row" : " rows")</span>
            </span>
        }
    };

    // ---- Groups -------------------------------------------------------------------------------

    private bool AllInGroupSelected(ZenTableGroup<TItem> group) =>
        group.Items.Count > 0 && group.Items.All(IsSelected);

    private bool SomeInGroupSelected(ZenTableGroup<TItem> group) => group.Items.Any(IsSelected);

    private async Task ToggleGroupSelectionAsync(ZenTableGroup<TItem> group, bool selected)
    {
        var next = new List<TItem>(SelectedItems ?? []);

        foreach (var item in group.Items)
        {
            next.Remove(item);
        }

        if (selected)
        {
            next.AddRange(group.Items);
        }

        await SelectedItemsChanged.InvokeAsync(next);
    }

    // ---- Picker -------------------------------------------------------------------------------

    /// <summary>The id of the element that scrolls the body - the table's wrapper.</summary>
    internal string ScrollContainerId => SubId("scroll");

    /// <summary>The id of a row's first cell, which a picker's text field points at.</summary>
    internal string CellId(int index) => $"{Id}-cell-{index}";

    /// <summary>Whether a row's text in any column contains the query - a picker's default search.</summary>
    internal bool AnyColumnContains(TItem item, string query) =>
        _columns.Exists(column =>
            column.TextFor(item)?.Contains(query, StringComparison.CurrentCultureIgnoreCase) == true);

    /// <summary>Whether the table has collected its columns yet.</summary>
    internal bool HasColumns => _columns.Count > 0;

    /// <summary>Whether the body is currently rendered through <c>&lt;Virtualize&gt;</c>.</summary>
    internal bool IsVirtualized => UseVirtualize;

    /// <summary>How many rows a picker's keyboard cursor can move through.</summary>
    internal int PickerRowCount =>
        UseVirtualize && ItemsProvider is not null ? _totalCount : _itemRows.Count;

    /// <summary>The row at an index, if it has been loaded.</summary>
    internal bool TryGetRow(int index, [MaybeNullWhen(false)] out TItem item)
    {
        if (UseVirtualize && ItemsProvider is not null)
        {
            return _loadedByIndex.TryGetValue(index, out item);
        }

        var row = index >= 0 && index < _rows.Count ? _rows[index] as ItemRow : null;
        item = row is null ? default : row.Item;
        return row is not null;
    }

    /// <summary>The index of a row on screen, or -1.</summary>
    internal int IndexOf(TItem item)
    {
        if (UseVirtualize && ItemsProvider is not null)
        {
            foreach (var (index, loaded) in _loadedByIndex)
            {
                if (EqualityComparer<TItem>.Default.Equals(loaded, item))
                {
                    return index;
                }
            }

            return -1;
        }

        return _itemRows.Find(r => EqualityComparer<TItem>.Default.Equals(r.Item, item))?.Index ?? -1;
    }

    /// <summary>
    /// Pointer tracking for a picker's rows, and nothing for any other table.
    /// </summary>
    /// <remarks>
    /// Splatted rather than written as <c>@@onmouseenter</c>, because an event attribute is wired
    /// whether or not its handler does anything. On Blazor Server every wired mouseenter is a
    /// round trip, and a table of a hundred rows would pay one per row the pointer crossed for a
    /// feature only the picker uses.
    /// </remarks>
    private Dictionary<string, object>? PickerRowAttributes(ItemRow row) => Picker is null
        ? null
        : new Dictionary<string, object>
        {
            ["onmouseenter"] = EventCallback.Factory.Create(this, () => Picker.RowHovered(row.Index)),
        };

    private RenderFragment HeaderContent(ZenColumn<TItem> column) => builder =>
    {
        if (column.HeaderTemplate is not null)
        {
            builder.AddContent(0, column.HeaderTemplate);
        }
        else
        {
            builder.AddContent(1, column.Title);
        }
    };

    private RenderFragment CellContent(ZenColumn<TItem> column, TItem item) => builder =>
    {
        if (column.CellTemplate is not null)
        {
            builder.AddContent(0, column.CellTemplate(item));
        }
        else
        {
            builder.AddContent(1, column.TextFor(item));
        }
    };

    /// <summary>The element id of a row, by its position among the rows on screen.</summary>
    /// <remarks>
    /// Position rather than the item's identity, because an item has no id the table can borrow -
    /// <c>TItem</c> is whatever the consumer handed over. Expanding a row renumbers everything
    /// below it, but the id is only ever used to move focus immediately after the render that
    /// produced these rows, so it is current by construction.
    /// </remarks>
    private string RowId(int index) => $"{Id}-row-{index}";

    private string RowLabel(ItemRow row) => RowText?.Invoke(row.Item) ?? row.Item.ToString() ?? "row";

    // ---- ARIA ---------------------------------------------------------------------------------

    private string? AriaSortFor(ZenColumn<TItem> column) => CanSort(column)
        ? _sortColumn == column ? (_sortDescending ? "descending" : "ascending") : "none"
        : null;

    /// <summary>
    /// The table's role: a treegrid for a hierarchy, a grid inside a picker, and otherwise none -
    /// a plain table.
    /// </summary>
    private string? TableRole => Hierarchical ? "treegrid" : Picker is not null ? "grid" : null;

    /// <summary>
    /// The total row count, stated only while virtualized - the one case where the DOM holds
    /// fewer rows than the table does. Counts the header row, as the ARIA definition requires.
    /// </summary>
    private int? AriaRowCount => Virtualize
        ? (ItemsProvider is not null ? _totalCount : _rowTotal) + 1
        : null;

    private int? AriaRowIndexFor(DisplayRow row) => Virtualize ? row.Index + 2 : null;

    /// <summary>
    /// A treegrid row states selection when rows are selectable; a picker row always does, since
    /// choosing a row is what a picker is for. A plain table leaves it to the checkboxes.
    /// </summary>
    private string? AriaSelectedFor(ItemRow row)
    {
        if (Picker is not null)
        {
            return Picker.IsChosen(row.Item) ? "true" : "false";
        }

        return Hierarchical && Selectable ? (IsSelected(row.Item) ? "true" : "false") : null;
    }

    /// <summary>
    /// Whether a column sorts. With a provider the server does the sorting, so a column needs a
    /// <see cref="ZenColumn{TItem}.SortName"/> to send it.
    /// </summary>
    private bool CanSort(ZenColumn<TItem> column) => ItemsProvider is not null
        ? (column.Sortable ?? true) && column.SortName is not null
        : column.CanSort;

    private string? AriaExpandedFor(ItemRow row) =>
        Hierarchical && row.HasChildren ? (row.IsExpanded ? "true" : "false") : null;

    private string PagerLabel => (Label ?? Caption) is { } name ? $"{name} pagination" : "Pagination";

    private string PageSummary
    {
        get
        {
            var total = PagingTotal;

            if (total == 0)
            {
                return "No rows";
            }

            var first = ((Math.Clamp(CurrentPage, 1, PageCount) - 1) * EffectivePageSize) + 1;
            var last = Math.Min(first + EffectivePageSize - 1, total);

            return $"{first}–{last} of {total}";
        }
    }

    // ---- Styling ------------------------------------------------------------------------------

    /// <summary>
    /// The stacked mobile layout, unless virtualizing: stacking turns each row into a card of a
    /// different height, and a virtualized body sizes its scrollbar from one row height.
    /// </summary>
    private bool Stacks => ResponsiveCollapse && !Virtualize;

    private string WrapperClass => CssBuilder
        // relative, so the wrapper - which is a scroll container - is also the containing block of
        // anything absolutely positioned inside the rows: visually hidden text, a checkbox's
        // overlaid mark. Without it their containing block is outside the scroller, so they stay
        // put while the rows scroll past. That is invisible to the eye, and it broke virtualization:
        // <Virtualize> measures the box around the rendered rows, the stranded group-count text
        // stretched that box by the whole scroll distance, and the row height it derived came out
        // a hundred times too large - collapsing the scrollbar on the next jump.
        .Default("relative w-full")
        // Horizontal scrolling only above the breakpoint where the table is still a table. Below
        // it the rows are stacked cards and there is nothing to scroll sideways.
        .AddClass(Stacks ? "md:overflow-x-auto" : "overflow-x-auto")
        // A height makes the wrapper the one scroll container on purpose. The header sticks to
        // the nearest scrolling ancestor, and overflow-x alone already made the wrapper that
        // ancestor - with no height, a sticky header had nothing inside it to stick against.
        .AddClass("overflow-y-auto", Height is not null)
        .AddClass("rounded-zen-lg border border-border bg-surface-raised", Bordered)
        .Build()!;

    private string? WrapperStyle => Height is null
        ? Style
        : $"max-height: {Height}; {Style}";

    private string TableClass => CssBuilder
        .Default("w-full border-collapse text-start")
        .AddClass("zen-table-stack", Stacks)
        .Build()!;

    private string HeadClass => CssBuilder
        .Default("border-b border-border")
        .AddClass("sticky top-0 z-10 bg-surface-raised", StickyHeader || Height is not null)
        .Build()!;

    /// <summary>
    /// A virtualized row is held to <see cref="ItemSize"/>, because the scrollbar was sized on
    /// that promise. A row taller than its estimate makes the thumb drift as the user scrolls.
    /// </summary>
    private string RowHeightStyle => $"height: {ItemSize.ToString(CultureInfo.InvariantCulture)}px";

    private string GroupCellClass => $"zen-table-group-cell text-start align-middle font-normal text-sm {CellPadding}";

    private const string GroupToggleClass =
        "zen-focus -mx-1 inline-flex min-w-0 items-center gap-2 rounded-zen-sm px-1 py-0.5 text-start";

    private static string GroupChevronClass(bool collapsed) => collapsed
        ? "size-4 shrink-0 text-content-subtle transition-transform"
        : "size-4 shrink-0 rotate-90 text-content-subtle transition-transform";

    private string HeaderCellClass =>
        $"text-start align-middle font-medium text-content-muted {CellPadding}";

    private string HeaderClassFor(ZenColumn<TItem> column) => CssBuilder
        .Default(HeaderCellClass)
        .AddClass(AlignClass(column.Align))
        .AddClass(column.HeaderClass)
        .Build()!;

    private string BodyCellClass => $"align-middle text-content {CellPadding}";

    private string BodyCellClassFor(ZenColumn<TItem> column) => CssBuilder
        .Default(BodyCellClass)
        .AddClass(AlignClass(column.Align))
        .AddClass(column.CellClass)
        .Build()!;

    private string RowClassFor(ItemRow row) => CssBuilder
        .Default("transition-colors")
        .AddClass("odd:bg-surface-sunken", Striped)
        .AddClass("hover:bg-surface-hover", Hoverable)
        .AddClass("cursor-pointer", OnRowClick.HasDelegate || Picker is not null)
        .AddClass("bg-primary-soft", Selectable && IsSelected(row.Item))
        // A picker's cursor is a background, not a focus ring: DOM focus is in the text field,
        // and a ring here would put two focus indicators on screen at once. The same reasoning,
        // and the same colours, as ZenCombobox's options.
        .AddClass("bg-primary-soft", Picker is not null && Picker.IsChosen(row.Item))
        .AddClass("bg-surface-hover", Picker is not null && Picker.ActiveIndex == row.Index && !Picker.IsChosen(row.Item))
        .AddClass("outline-none", Hierarchical)
        .AddClass("zen-focus-always", Hierarchical && IsActive(row.Item))
        .AddClass(RowClass?.Invoke(row.Item))
        .Build()!;

    private const string DetailToggleClass =
        "zen-focus grid size-6 shrink-0 place-items-center rounded-zen-sm text-content-subtle " +
        "transition-colors hover:bg-surface-hover hover:text-content";

    private string DetailChevronClass(TItem item) => CssBuilder
        .Default("size-4 transition-transform")
        .AddClass("rotate-90", IsDetailOpen(item))
        .Build()!;

    // Sunken rather than raised: the panel belongs to the row above it, and a surface that sits
    // forward of the table would read as a separate card that had landed on top of the rows.
    private const string DetailRowClass = "bg-surface-sunken";

    // The library's own input treatment, minus everything that belongs to a form control: no
    // full width, no validation hooks, no field wrapper. See the comment at the call site for why
    // this is not a ZenSelect.
    private const string PageSizeSelectClass =
        "zen-focus-border h-8 rounded-zen-sm border border-border bg-surface py-0 ps-2 pe-7 " +
        "text-sm text-content transition-colors";

    private static string AlignClass(ZenAlign align) => align switch
    {
        ZenAlign.Center => "text-center",
        ZenAlign.End => "text-end",
        _ => "text-start",
    };

    private string CellPadding => Size switch
    {
        ZenSize.Small => "px-2.5 py-1.5 text-sm",
        ZenSize.Large => "px-4 py-3 text-base",
        _ => "px-3 py-2 text-sm",
    };

    private const string SortButtonClass =
        "zen-focus group -mx-1 inline-flex items-center gap-1 rounded-zen-sm px-1 py-0.5 " +
        "font-medium transition-colors hover:text-content";

    private string SortIconFor(ZenColumn<TItem> column) =>
        _sortColumn == column && _sortDescending ? ZenIcons.ChevronDown : ZenIcons.ChevronUp;

    /// <summary>
    /// The sort indicator's classes.
    /// </summary>
    /// <remarks>
    /// An unsorted column shows its indicator faintly rather than hiding it until hover. Hidden
    /// was the first version and it made every header look inert: nothing on the page said the
    /// table could be sorted, and a pointer user had to guess while a touch user, who has no
    /// hover at all, could not have found out. A faint chevron is the affordance; hover and the
    /// active sort are the two states above it.
    /// </remarks>
    private string SortIconClass(ZenColumn<TItem> column) => CssBuilder
        .Default("size-3.5 shrink-0 transition-opacity")
        .AddClass(_sortColumn == column ? "opacity-100" : "opacity-35 group-hover:opacity-70")
        .Build()!;

    private static string? WidthStyle(ZenColumn<TItem> column) =>
        column.Width is null ? null : $"width: {column.Width}";
}
