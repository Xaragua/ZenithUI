# Normalize line endings so the repo is identical regardless of which platform committed.
# Without this, CI on Linux and development on Windows disagree about every file.
* text=auto

*.cs      text diff=csharp
*.razor   text
*.css     text
*.js      text
*.json    text
*.md      text
*.yml     text
*.csproj  text
*.props   text
*.targets text
*.slnx    text

# Shell scripts must keep LF even when checked out on Windows - CRLF breaks the shebang.
*.sh text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff  binary
*.woff2 binary
